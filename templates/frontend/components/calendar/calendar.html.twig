<div {{ attributes }}>
    <div class="calendar-header">
        {% include '@ForumifyCalendarPlugin/frontend/components/calendar/calendar_select.html.twig' %}
        <div class="flex items-center gap-2">
            {{ component('Forumify\\CalendarNotifications', { calendar: this.selectedCalendar }) }}
            {% if this.showManageCalendarBtn %}
                <a class="btn-primary btn-icon" href="{{ path('forumify_calendar_event_create', { calendar: this.selectedCalendar }) }}">
                    <i class="ph ph-plus"></i>
                    <span class="hide-phone ml-2">{{ 'calendar.event.create'|trans }}</span>
                </a>
            {% endif %}
        </div>
    </div>
    <div class="card">
        <div class="calendar-toolbar">
            <div class="flex items-center gap-4">
                <div class="calendar-segmented" role="group" aria-label="{{ 'calendar.navigation'|trans }}">
                    <button class="btn-link btn-icon" aria-label="{{ 'calendar.previous'|trans }}" {{ live_action('prev') }}>
                        <i class="ph ph-caret-left"></i>
                    </button>
                    <button class="btn-link" {{ live_action('today') }}>{{ 'calendar.today'|trans }}</button>
                    <button class="btn-link btn-icon" aria-label="{{ 'calendar.next'|trans }}" {{ live_action('next') }}>
                        <i class="ph ph-caret-right"></i>
                    </button>
                </div>
                <h2 class="calendar-period">
                    {{ this.view|date('F Y') }}
                    {% if this.viewMode == 'week' %}
                        <span class="text-light">{{ 'calendar.week_number'|trans({ week: this.view|date('W') }) }}</span>
                    {% endif %}
                </h2>
            </div>
            <div class="calendar-segmented" role="group" aria-label="{{ 'calendar.view_mode'|trans }}">
                {% for viewMode in constant('Forumify\\Calendar\\Component\\CalendarComponent::VIEW_MODES') %}
                    {% set active = this.viewMode == viewMode %}
                    <button
                        class="btn-link{% if active %} active{% endif %}"
                        aria-pressed="{{ active ? 'true' : 'false' }}"
                        {{ live_action('setViewMode', { viewMode: viewMode }) }}
                    >
                        {{ ('calendar.view.' ~ viewMode)|trans }}
                    </button>
                {% endfor %}
            </div>
        </div>
        <div class="w-100" style="max-width: 100%; overflow-x: auto">
            <div class="calendar">
                {% if this.viewMode == 'month' %}
                    {% include '@ForumifyCalendarPlugin/frontend/components/calendar/calendar_month.html.twig' %}
                {% else %}
                    {% include '@ForumifyCalendarPlugin/frontend/components/calendar/calendar_week.html.twig' %}
                {% endif %}
            </div>
        </div>
    </div>
    <p class="text-small text-light mt-2">
        <i class="ph ph-clock"></i>
        {{ 'calendar.timezone_notice'|trans({ timezone: this.timezone }) }}
        {% if app.user is null %}
            {%- set loginPath = path('forumify_core_login', {
                '_target_path': path('forumify_calendar_all', this.selectedCalendar ? { slug: this.selectedCalendar.slug } : {}),
            }) -%}
            {{ 'calendar.timezone_notice_guest'|trans({ loginPath: loginPath })|raw }}
        {% endif %}
    </p>
</div>
