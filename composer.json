{
    "name": "forumify/forumify-calendar-plugin",
    "description": "Calendar plugin for forumify",
    "type": "forumify-plugin",
    "keywords": ["symfony-ux"],
    "license": "OSL-3.0",
    "require": {
        "forumify/forumify-platform": "^1.2.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "phpstan/phpstan-symfony": "^2.0",
        "slevomat/coding-standard": "^8.15",
        "dama/doctrine-test-bundle": "^8.0",
        "dg/bypass-finals": "^1.9",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*",
        "zenstruck/foundry": "2.8.7",
        "symfony/lock": "7.4.x"
    },
    "autoload": {
        "psr-4": {
            "Forumify\\Calendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PluginTests\\": "tests/",
            "Tests\\Tests\\Factories\\": "vendor/forumify/forumify-platform/tests/Tests/Factories/",
            "Tests\\Tests\\Application\\Api\\": "vendor/forumify/forumify-platform/tests/Tests/Application/Api/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "lock": false
    },
    "extra": {
        "forumify-plugin-class": "Forumify\\Calendar\\ForumifyCalendarPlugin",
        "branch-alias": {
            "dev-master": "1.1.x-dev"
        }
    }
}
